QWidget {
    background-color: #f0f8ff;
    font-family: Arial;
    font-size: 14px;
}

#header {
    background-color: #3498db;
    color: white;
    font-size: 20px;
    font-weight: bold;
    padding: 20px;
}

QLineEdit {
    padding: 6px;
    border: 1px solid #ccc;
    border-radius: 4px;
}

QPushButton {
    background-color: #3498db;
    color: white;
    border-radius: 6px;
    padding: 8px 12px;
}

QPushButton:hover {
    background-color: #2980b9;
}

#statBox {
    background-color: white;
    font-weight: bold;
    padding: 10px;
    border-radius: 6px;
}

#featuredTitle {
    font-size: 16px;
    font-weight: bold;
    margin-top: 20px;
}
